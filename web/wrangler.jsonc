{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "prompt-battle",
	"compatibility_date": "2026-09-10",
	// Keep the workers.dev address alive alongside the custom domain.
	"workers_dev": true,
	// Custom domain: wrangler owns the DNS record and certificate for this hostname.
	"routes": [{ "pattern": "battle.hyperplexed.io", "custom_domain": true }],
	// Assets only — no Worker script runs, so requests never count as invocations.
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	}
}
