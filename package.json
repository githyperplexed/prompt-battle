{
	"name": "prompt-battle",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"db",
		"worker",
		"web"
	],
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test",
		"db:generate": "bun run --filter @prompt-battle/db db:generate",
		"db:migrate": "bun run --filter @prompt-battle/db db:migrate",
		"db:push": "bun run --filter @prompt-battle/db db:push",
		"db:studio": "bun run --filter @prompt-battle/db db:studio",
		"worker": "bun worker/src/cli.ts",
		"web:dev": "bun run --filter @prompt-battle/web dev",
		"web:build": "bun run --filter @prompt-battle/web build",
		"web:check": "bun run --filter @prompt-battle/web check",
		"web:deploy": "bun run --filter @prompt-battle/web deploy"
	},
	"devDependencies": {
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^6.0.3"
	}
}
